# ops-platform 环境参数模板（公开仓库展示用）。真实值写 .env（gitignored）。
# 生成方法：
#   ACCESS_KEY_ENCRYPTION: openssl rand -base64 32   （32 字节密钥，用于加密面板内存的凭据）
#   ADMIN_PASSWORD:        openssl rand -hex 8
SEMAPHORE_ADMIN=admin
SEMAPHORE_ADMIN_PASSWORD=admin   # 本地面板统一账号线 admin/admin（D5 上服务器前必须复盘换强密码）
SEMAPHORE_ADMIN_EMAIL=admin@ops.local
SEMAPHORE_ACCESS_KEY_ENCRYPTION=[CHANGE_ME_base64_32bytes]
# D3 备份仓库加密密钥（restic repo 密码）：丢失=所有快照永久解不开（restic 无找回机制）
#   生成：openssl rand -hex 16（本机实测 36 字符值）；compose :? 守卫=缺失拒启
RESTIC_PASSWORD=[CHANGE_ME_hex16]
# Jenkins 管理员（ops-jenkins，本地约定线 admin，D5 复盘换强密码）
JENKINS_ADMIN_PASSWORD=[CHANGE_ME]
# Gitea 管理员（ops-gitea，本地约定线 admin，D5 复盘换强密码）
GITEA_ADMIN_PASSWORD=[CHANGE_ME]
# Kuma widget 凭据（Homepage 顶部状态绿卡读 Kuma API 用；本地约定线 admin/admin）
HOMEPAGE_VAR_KUMA_USERNAME=admin
HOMEPAGE_VAR_KUMA_PASSWORD=admin
# 注：Adminer 无需任何环境变量——数据库凭据在登录页手输（账号 admin=MySQL 只读身份，仅 SELECT）
